<div class="main">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <h2>Configurações</h2>

    <div class="group">
      <h4>📏 Espaçamento</h4>

      <div class="control">
        <label>Linhas</label>
        <label id="lineValue">1.6</label>
        <div>
          <button data-action="line-dec">-</button>
          <button data-action="line-inc">+</button>
        </div>
      </div>

      <div class="control">
        <label>Palavras</label>
        <label id="wordValue">0.2</label>
        <div>
          <button data-action="word-dec">-</button>
          <button data-action="word-inc">+</button>
        </div>
      </div>

      <div class="control">
        <label>Letras</label>
        <label id="letterValue">0.0</label>
        <div>
          <button data-action="letter-dec">-</button>
          <button data-action="letter-inc">+</button>
        </div>
      </div>

      <div class="control">
        <label>Tamanho</label>
        <label id="fontSizeValue">1.0x</label>
        <div>
          <button data-action="font-dec">-</button>
          <button data-action="font-inc">+</button>
        </div>
      </div>
    </div>

    <div class="group">
      <h4>🎨 Aparência</h4>

      <div class="appearance-control">
        <label>Fonte</label>

        <select id="fontSelector">
          <option value="Arial">Normal</option>
          <option value="Verdana">Verdana</option>
        </select>
      </div>

      <div class="appearance-control">
        <label>Cor de fundo</label>

        <input type="color" id="backgroundColor" value="#d6c8bd" />
      </div>

      <div class="appearance-control">
        <label>Cor da fonte</label>

        <input type="color" id="fontColor" value="#2E2E2E" />
      </div>
    </div>

    <div class="group reading-group">
      <h4>🔊 Leitura</h4>

      <div class="reading-control">
        <label for="velocidade">Velocidade</label>

        <input type="range" min="0.5" max="2" step="0.1" value="1" id="velocidade" />
      </div>

      <div class="reading-control">
        <label for="vozes">Voz</label>

        <select id="vozes"></select>
      </div>

      <div class="reading-control">
        <label>Controles</label>

        <div class="buttons">
          <button id="playButton">▶️</button>
          <button id="pauseButton">⏸️ Pausar</button>
        </div>
      </div>
    </div>

    <div class="group">
      <button id="breakLinesButton">
        Quebrar linhas
      </button>
    </div>
  </aside>

  <!-- CONTEÚDO -->
  <div class="content" id="resultado">
    {{{textoHtml}}}
  </div>
</div>

<div id="dictionaryModal" class="dictionary-modal hidden">
  <div class="dictionary-card">
    <div class="dictionary-header">
      <h3 id="dictionaryWord">Palavra</h3>

      <button id="closeDictionary">
        ✖
      </button>
    </div>

    <div id="dictionaryContent">
      Carregando...
    </div>
  </div>
</div>

<script>
  class DictionaryStore {
    constructor() {
      this.cache = new Map();
      this.baseUrl = "http://localhost:3000/api/word";
    }

    async getWord(word) {
      const normalized =
        word
          .toLowerCase()
          .trim()
          .replace(/[.,!?;:()"]/g, "");

      if (!normalized) {
        return null;
      }

      // cache
      if (this.cache.has(normalized)) {
        return this.cache.get(normalized);
      }

      try {
        const response = await fetch(
          `${this.baseUrl}/${encodeURIComponent(normalized)}`
        );

        const data = await response.json();

        // backend retornou erro
        if (!response.ok || data.error) {
          return {
            error: true,
            message: "Palavra não encontrada."
          };
        }

        this.cache.set(normalized, data);

        return data;
      } catch (error) {
        return {
          error: true,
          message: "Erro ao buscar palavra."
        };
      }
    }
  }

  class ReaderUI {
    constructor() {
      this.content = document.getElementById("resultado");

      this.state = {
        lineSpacing: 1.6,
        wordSpacing: 0.2,
        letterSpacing: 0,
        fontSize: 1,
      };

      this.synth = window.speechSynthesis;
      this.utterance = null;

      this.dictionary = new DictionaryStore();

      this.lastRange = null;
      this.lastNode = null;

      this.init();
    }

    init() {
      this.bindEvents();
      this.loadVoices();
      this.applyStyles();
      this.wrapWords();
      this.enableWordClick();
      this.enableWordHover();

      speechSynthesis.onvoiceschanged = () => {
        this.loadVoices();
      };

      window.addEventListener("load", () => {
        this.loadVoices();

        setTimeout(() => {
          this.loadVoices();
        }, 500);
      });

      document
        .getElementById(
          "closeDictionary"
        )
        .addEventListener(
          "click",
          () => {
            this.closeDictionaryModal();
          }
        );
    }

    bindEvents() {
      document.addEventListener("click", (event) => {
        const action = event.target.dataset.action;

        if (!action) return;

        switch (action) {
          case "line-inc":
            this.updateLineSpacing(0.2);
            break;

          case "line-dec":
            this.updateLineSpacing(-0.2);
            break;

          case "word-inc":
            this.updateWordSpacing(0.2);
            break;

          case "word-dec":
            this.updateWordSpacing(-0.2);
            break;

          case "letter-inc":
            this.updateLetterSpacing(0.1);
            break;

          case "letter-dec":
            this.updateLetterSpacing(-0.1);
            break;

          case "font-inc":
            this.updateFontSize(0.2);
            break;

          case "font-dec":
            this.updateFontSize(-0.2);
            break;
        }
      });

      document
        .getElementById("fontSelector")
        .addEventListener("change", (e) => {
          this.content.style.fontFamily = e.target.value;
        });

      document
        .getElementById("backgroundColor")
        .addEventListener("change", (e) => {
          this.content.style.setProperty(
            "--background-color",
            e.target.value
          );
        });

      document
        .getElementById("fontColor")
        .addEventListener("change", (e) => {
          this.content.style.setProperty(
            "--font-color",
            e.target.value
          );
        });

      document
        .getElementById("breakLinesButton")
        .addEventListener("click", () => {
          this.breakLines();
        });

      document
        .getElementById("playButton")
        .addEventListener("click", () => {
          this.readText();
        });

      document
        .getElementById("pauseButton")
        .addEventListener("click", () => {
          this.togglePause();
        });
    }

    applyStyles() {
      this.content.style.lineHeight =
        this.state.lineSpacing;

      this.content.style.wordSpacing =
        `${this.state.wordSpacing}em`;

      this.content.style.letterSpacing =
        `${this.state.letterSpacing}em`;

      this.content.style.fontSize =
        `${this.state.fontSize}em`;
    }

    updateLineSpacing(value) {
      const next =
        this.state.lineSpacing + value;

      if (next < 1) return;

      this.state.lineSpacing = next;

      this.content.style.lineHeight = next;

      document.getElementById(
        "lineValue"
      ).textContent = next.toFixed(1);
    }

    updateWordSpacing(value) {
      const next =
        this.state.wordSpacing + value;

      if (next < 0) return;

      this.state.wordSpacing = next;

      this.content.style.wordSpacing =
        `${next}em`;

      document.getElementById(
        "wordValue"
      ).textContent = next.toFixed(1);
    }

    updateLetterSpacing(value) {
      const next =
        this.state.letterSpacing + value;

      if (next < 0) return;

      this.state.letterSpacing = next;

      this.content.style.letterSpacing =
        `${next}em`;

      document.getElementById(
        "letterValue"
      ).textContent = next.toFixed(1);
    }

    updateFontSize(value) {
      const next =
        this.state.fontSize + value;

      if (next < 0.5) return;

      this.state.fontSize = next;

      this.content.style.fontSize =
        `${next}em`;

      document.getElementById(
        "fontSizeValue"
      ).textContent =
        `${next.toFixed(1)}x`;
    }

    breakLines() {
      const text = this.content.innerText;

      const formatted =
        text.replace(/\./g, ".<br><br>");

      this.content.innerHTML = formatted;
    }

    loadVoices() {
      const select =
        document.getElementById("vozes");

      const voices =
        this.synth.getVoices() || [];

      select.innerHTML = "";

      voices.forEach((voice, index) => {
        const option =
          document.createElement("option");

        option.value = index;

        option.textContent =
          `${voice.name} (${voice.lang})`;

        select.appendChild(option);
      });
    }

    readText() {
      const text =
        this.content.innerText.trim();

      if (!text) return;

      this.synth.cancel();

      this.utterance =
        new SpeechSynthesisUtterance(text);

      this.utterance.lang = "pt-BR";

      this.utterance.rate =
        document.getElementById(
          "velocidade"
        ).value;

      const voices =
        this.synth.getVoices() || [];

      const selectedVoice =
        document.getElementById("vozes").value;

      if (
        voices.length &&
        selectedVoice !== ""
      ) {
        this.utterance.voice =
          voices[selectedVoice];
      }

      this.utterance.onend = () => {
        this.resetPauseButton();
        this.utterance = null;
      };

      this.utterance.onerror = () => {
        this.utterance = null;
      };

      this.synth.speak(this.utterance);

      this.resetPauseButton();
    }

    togglePause() {
      const button =
        document.getElementById("pauseButton");

      if (
        this.synth.speaking &&
        !this.synth.paused
      ) {
        this.synth.pause();

        button.textContent =
          "▶️ Resumir";

        return;
      }

      if (this.synth.paused) {
        this.synth.resume();

        button.textContent =
          "⏸️ Pausar";
      }
    }

    resetPauseButton() {
      document.getElementById(
        "pauseButton"
      ).textContent = "⏸️ Pausar";
    }

    enableWordClick() {
      this.content.addEventListener("click", async (event) => {
        const range = document.caretRangeFromPoint?.(
          event.clientX,
          event.clientY
        );

        if (!range) return;

        const node = range.startContainer;

        if (!node || node.nodeType !== 3) return;

        const text = node.textContent;

        const word = this.getWordFromText(text, range.startOffset);

        if (!word) return;

        const result =
          await this.dictionary.getWord(word);

        this.openDictionaryModal(word, result);
      });
    }

    getWordFromText(text, offset) {
      const left = text.slice(0, offset);
      const right = text.slice(offset);

      const leftMatch =
        left.match(/[\p{L}]+$/u);

      const rightMatch =
        right.match(/^[\p{L}]+/u);

      const word =
        (leftMatch ? leftMatch[0] : "") +
        (rightMatch ? rightMatch[0] : "");

      return word || null;
    }

    enableWordHover() {
      this.content.addEventListener("mousemove", (event) => {
        const range = document.caretRangeFromPoint?.(
          event.clientX,
          event.clientY
        );

        if (!range) return;

        const node = range.startContainer;

        if (!node || node.nodeType !== 3) return;

        this.clearHighlight();

        const span = this.getWordRangeSpan(node, range.startOffset);

        if (!span) return;

        span.classList.add("word-highlight");

        this.lastNode = span;
      });

      this.content.addEventListener("mouseleave", () => {
        this.clearHighlight();
      });
    }

    getWordRangeSpan(textNode, offset) {
      const text = textNode.textContent;

      const left = text.slice(0, offset);
      const right = text.slice(offset);

      const leftMatch = left.match(/[\p{L}]+$/u);
      const rightMatch = right.match(/^[\p{L}]+/u);

      const word =
        (leftMatch ? leftMatch[0] : "") +
        (rightMatch ? rightMatch[0] : "");

      if (!word) return null;

      return {
        classList: {
          add: () => { },
          remove: () => { }
        },
        node: textNode,
        word
      };
    }

    wrapWords() {
      const walker = document.createTreeWalker(
        this.content,
        NodeFilter.SHOW_TEXT,
        null
      );

      const nodes = [];

      while (walker.nextNode()) {
        nodes.push(walker.currentNode);
      }

      nodes.forEach((node) => {
        const text = node.nodeValue;

        if (!text.trim()) return;

        const words = text.split(/(\s+)/);

        const spanized = words
          .map((w) => {
            if (/\s+/.test(w)) return w;

            const clean = w.replace(/[^\p{L}]/gu, "");

            if (!clean) return w;

            return `<span class="word" data-word="${clean}">${w}</span>`;
          })
          .join("");

        const wrapper = document.createElement("span");
        wrapper.innerHTML = spanized;

        node.replaceWith(wrapper);
      });
    }

    openDictionaryModal(word, result) {
      const modal =
        document.getElementById(
          "dictionaryModal"
        );

      const title =
        document.getElementById(
          "dictionaryWord"
        );

      const content =
        document.getElementById(
          "dictionaryContent"
        );

      title.textContent = word;

      if (
        !result ||
        result.error
      ) {
        content.innerHTML = `
      <p>
        ${result?.message ||
          "Nenhuma definição encontrada."}
      </p>
    `;
      } else {
        content.innerHTML =
          result.definitions
            .map(
              (definition) => `
            <div class="definition">
              • ${definition}
            </div>
          `
            )
            .join("");
      }

      modal.classList.remove("hidden");
    }

    closeDictionaryModal() {
      document
        .getElementById(
          "dictionaryModal"
        )
        .classList.add("hidden");
    }
  }

  new ReaderUI();
</script>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
  }

  /* LAYOUT */
  .main {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  .sidebar {
    width: 260px;
    background: #2b2b2b;
    color: white;
    padding: 20px;

    overflow-y: auto;
    height: 100vh;

    flex-shrink: 0;
  }

  .content {
    flex: 1;

    overflow-y: auto;
    height: 100vh;

    padding: 20px;

    display: flex;
    justify-content: center;

    --background-color: #d6c8bd;
    --font-color: #2e2e2e;

    background-color: var(--background-color);
    color: var(--font-color);

    line-height: 1.6;
    word-spacing: 0.2em;
    letter-spacing: 0;
    font-size: 1em;
  }

  .content {
    cursor: text;
    user-select: text;
  }

  .content {
    cursor: pointer;
  }

  .content:hover {
    cursor: pointer;
  }

  .content * {
    cursor: pointer;
  }

  /* GRUPOS */
  .group {
    margin-bottom: 24px;
  }

  .group h4 {
    margin-bottom: 14px;
  }

  /* CONTROLES */
  .control {
    display: grid;

    grid-template-columns:
      1fr 60px auto;

    align-items: center;

    gap: 10px;

    margin-bottom: 12px;
  }

  .control label:nth-child(2) {
    text-align: center;
  }

  .control div {
    display: flex;
    gap: 6px;
  }

  /* BOTÕES */
  button {
    border: none;
    border-radius: 6px;

    background: #444;
    color: white;

    cursor: pointer;

    padding: 8px 12px;

    transition: background 0.2s;
  }

  button:hover {
    background: #666;
  }

  .control button {
    width: 32px;
    height: 32px;
    padding: 0;
  }

  /* APARÊNCIA */
  .appearance-control,
  .reading-control {
    display: flex;
    flex-direction: column;
    gap: 6px;

    margin-bottom: 14px;
  }

  .appearance-control label,
  .reading-control label {
    font-size: 14px;
    font-weight: bold;
  }

  select,
  input[type="color"] {
    width: 100%;
    height: 38px;
  }

  input[type="range"] {
    width: 100%;
  }

  .buttons {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }

  .dictionary-word {
    cursor: pointer;
    border-radius: 4px;
  }

  .dictionary-word:hover {
    background: rgba(0, 0, 0, 0.12);
  }

  .word-highlight {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
  }

  .word {
    cursor: pointer;
    transition: 0.15s;
    border-radius: 4px;
  }

  .word:hover {
    background: rgba(0, 0, 0, 0.12);
  }

  .dictionary-modal {
    position: fixed;
    inset: 0;

    background: rgba(0, 0, 0, 0.45);

    display: flex;
    align-items: center;
    justify-content: center;

    z-index: 999;
  }

  .dictionary-modal.hidden {
    display: none;
  }

  .dictionary-card {
    width: min(700px, 90%);
    max-height: 80vh;

    overflow-y: auto;

    background: white;
    border-radius: 12px;

    padding: 20px;

    color: #222;
  }

  .dictionary-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 20px;
  }

  .definition {
    margin-bottom: 14px;
    line-height: 1.6;
  }
</style>