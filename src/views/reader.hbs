<div class="main">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <h2>Configurações</h2>

    <div class="group">
      <h4>📏 Espaçamento</h4>
      <div class="control">
        <label>Linhas</label>
        <label id="lineValue">0</label>
        <div>
          <button onclick="decreaseLineSpacing()">-</button>
          <button onclick="increaseLineSpacing()">+</button>
        </div>
      </div>

      <div class="control">
        <label>Palavras</label>
        <label id="wordValue">0</label>
        <div>
          <button onclick="decreaseWordSpacing()">-</button>
          <button onclick="increaseWordSpacing()">+</button>
        </div>
      </div>

      <div class="control">
        <label>Letras</label>
        <label id="letterValue">0</label>
        <div>
          <button onclick="decreaseLetterSpacing()">-</button>
          <button onclick="increaseLetterSpacing()">+</button>
        </div>
      </div>

      <div class="control">
        <label>Tamanho</label>
        <label id="fontSize">0</label>
        <div>
          <button onclick="decreaseFontSize()">-</button>
          <button onclick="increaseFontSize()">+</button>
        </div>
      </div>
    </div>

    <div class="group">
      <h4>🎨 Aparência</h4>

      <div class="appearance-control">
        <label>Fonte</label>
        <select onchange="mudarFonte(this.value)">
          <option value="Arial">Normal</option>
          <option value="Verdana">Mais legível</option>
        </select>
      </div>

      <div class="appearance-control">
        <label>Cor de fundo</label>
        <input type="color" value="#d6c8bd"
          onchange="document.getElementById('resultado').style.setProperty('--background-color', this.value)">
      </div>

      <div class="appearance-control">
        <label>Cor da fonte</label>
        <input type="color" value="#2E2E2E"
          onchange="document.getElementById('resultado').style.setProperty('--font-color', this.value)">
      </div>
    </div>

    <div class="group reading-group">
      <h4>🔊 Leitura</h4>

      <div class="reading-control">
        <label for="velocidade">Velocidade</label>
        <input type="range" min="0.5" max="2" step="0.1" value="1" id="velocidade">
      </div>

      <div class="reading-control">
        <label for="vozes">Voz</label>
        <select id="vozes"></select>
      </div>

      <div class="reading-control">
        <label>Controles</label>

        <div class="buttons">
          <button onclick="lerTexto()">▶️</button>
          <button onclick="pause()" id="pause-button">⏸️</button>
        </div>
      </div>
    </div>

    <div class="group">
      <button onclick="breakLines()">Quebrar linhas</button>
    </div>
  </aside>

  <div class="content" id="resultado">
    {{{textoHtml}}}
  </div>
</div>


<script>
  let lineSpacing = 1.6;
  let wordSpacing = 0.2;
  let letterSpacing = 0;
  let dyslexicFont = false;
  let fontSize = 1;
  const synth = window.speechSynthesis;
  let utterance = null;

  function toggleFont() {
    const output = document.getElementById('resultado');
    dyslexicFont = !dyslexicFont;
    output.classList.toggle('dyslexic');
  }

  function increaseLineSpacing() {
    lineSpacing += 0.2;
    document.getElementById('resultado').style.lineHeight = lineSpacing;
    document.getElementById('lineValue').textContent = lineSpacing.toFixed(1);
  }

  function decreaseLineSpacing() {
    if (lineSpacing > 1) {
      lineSpacing -= 0.2;
      document.getElementById('resultado').style.lineHeight = lineSpacing;
      document.getElementById('lineValue').textContent = lineSpacing.toFixed(1);
    }
  }

  function increaseWordSpacing() {
    wordSpacing += 0.2;
    document.getElementById('resultado').style.wordSpacing = wordSpacing + 'em';
    document.getElementById('wordValue').textContent = wordSpacing.toFixed(1);
  }

  function decreaseWordSpacing() {
    if (wordSpacing > 0.2) {
      wordSpacing -= 0.2;
      document.getElementById('resultado').style.wordSpacing = wordSpacing + 'em';
      document.getElementById('wordValue').textContent = wordSpacing.toFixed(1);
    }
  }

  function increaseLetterSpacing() {
    letterSpacing += 0.2;
    document.getElementById('resultado').style.letterSpacing = letterSpacing + 'em';
    document.getElementById('letterValue').textContent = letterSpacing.toFixed(1);
  }

  function decreaseLetterSpacing() {
    if (letterSpacing > 0.2) {
      letterSpacing -= 0.2;
      document.getElementById('resultado').style.letterSpacing = letterSpacing + 'em';
      document.getElementById('letterValue').textContent = letterSpacing.toFixed(1);
    }
  }

  function increaseFontSize() {
    fontSize += 0.1;
    document.getElementById('resultado').style.fontSize = fontSize + 'em';
    document.getElementById('fontSize').textContent = fontSize.toFixed(1) + 'x';
  }

  function decreaseFontSize() {
    if (fontSize > 0.5) {
      fontSize -= 0.1;
      document.getElementById('resultado').style.fontSize = fontSize + 'em';
      document.getElementById('fontSize').textContent = fontSize.toFixed(1) + 'x';
    }
  }

  function breakLines() {
    const texto = document.getElementById("resultado").innerText;
    const adaptado = texto.replace(/\./g, ".<br><br>");
    document.getElementById("resultado").innerHTML = adaptado;
  }

  function mudarFonte(fonte) {
    document.getElementById("resultado").style.fontFamily = fonte;
  }

  function carregarVozes() {
    let select = document.getElementById("vozes");
    let vozes = synth.getVoices() || [];

    select.innerHTML = "";

    vozes.forEach((voz, index) => {
      let option = document.createElement("option");
      option.value = index;
      option.textContent = voz.name + " (" + voz.lang + ")";
      select.appendChild(option);
    });
  }

  // Some browsers populate voices asynchronously
  speechSynthesis.onvoiceschanged = carregarVozes;
  window.addEventListener('load', () => { carregarVozes(); setTimeout(carregarVozes, 500); });

  function lerTexto() {
    const text = document.getElementById("resultado").innerText;
    if (!text) return;

    // Cancela qualquer fala anterior antes de começar outra
    synth.cancel();

    utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'pt-BR';

    // velocidade
    let velocidade = document.getElementById("velocidade").value;
    utterance.rate = velocidade;

    // voz escolhida (safely)
    let vozes = synth.getVoices() || [];
    let index = document.getElementById("vozes").value;
    if (vozes.length && index !== "") {
      utterance.voice = vozes[index];
    }

    utterance.onend = () => {
      document.getElementById("pause-button").textContent = "⏸️ Pausar";
      utterance = null;
    };
    utterance.onerror = () => { utterance = null; };

    synth.speak(utterance);
    document.getElementById("pause-button").textContent = "⏸️ Pausar";
  }

  function pause() {
    // toggle pause/resume and update button label
    if (synth.speaking && !synth.paused) {
      synth.pause();
      document.getElementById("pause-button").textContent = "▶️ Resumir";
    } else if (synth.paused) {
      synth.resume();
      document.getElementById("pause-button").textContent = "⏸️ Pausar";
    }
  }
</script>

<style>
  /* Reset básico */
  body {
    margin: 0;
    font-family: Arial, sans-serif;
  }

  /* HEADER FIXO */
  .header {
    height: 60px;
    background: #1e1e1e;
    color: white;
    display: flex;
    align-items: center;
    padding: 0 20px;
  }

  /* ÁREA ABAIXO DO HEADER */
  .main {
    display: flex;
    height: calc(100vh - 60px);
    /* ocupa o resto da tela */
  }

  /* SIDEBAR */
  .sidebar {
    width: 260px;
    background: #2b2b2b;
    color: white;
    padding: 20px;
    overflow-y: auto;
  }

  /* CONTEÚDO */
  .content {
    flex: 1;
    padding: 20px;
    overflow-y: auto;

    display: flex;
    justify-content: center;
  }

  #resultado {
    --background-color: #d6c8bd;
    --font-color: #2E2E2E;
    background-color: var(--background-color);
    color: var(--font-color);
  }

  /* CONTROLES */
  .group {
    margin-bottom: 25px;
  }

  .control {
    display: grid;
    grid-template-columns: 1fr 50px auto;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .control label:first-child {
    text-align: left;
  }

  .control label:nth-child(2) {
    text-align: center;
    min-width: 50px;
  }

  .control div {
    display: flex;
    gap: 6px;
  }

  .control button {
    width: 32px;
    height: 32px;
    padding: 0;
  }

  button {
    padding: 6px 10px;
    border: none;
    border-radius: 6px;
    background: #444;
    color: white;
    cursor: pointer;
  }

  button:hover {
    background: #666;
  }

  .appearance-control {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
  }

  .appearance-control label {
    font-size: 14px;
    font-weight: bold;
  }

  .appearance-control input[type="color"] {
    width: 100%;
    height: 40px;
    padding: 2px;
    cursor: pointer;
  }

  .appearance-control select {
    height: 36px;
  }

  .reading-group {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .reading-group input[type="range"] {
    width: 100%;
  }

  .reading-group select {
    height: 36px;
  }

  .reading-control {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .reading-control label {
    font-size: 14px;
    font-weight: bold;
  }

  .buttons {
    margin-top: 4px;
    display: flex;
    gap: 10px;
  }
</style>