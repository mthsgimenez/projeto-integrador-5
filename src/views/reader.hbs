<div class="main">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <h2>Configurações</h2>

    <div class="group">
      <h4>📏 Espaçamento</h4>

      <div class="control">
        <label>Linhas</label>
        <label id="lineValue">1.6</label>
        <div>
          <button data-action="line-dec">-</button>
          <button data-action="line-inc">+</button>
        </div>
      </div>

      <div class="control">
        <label>Palavras</label>
        <label id="wordValue">0.2</label>
        <div>
          <button data-action="word-dec">-</button>
          <button data-action="word-inc">+</button>
        </div>
      </div>

      <div class="control">
        <label>Letras</label>
        <label id="letterValue">0.0</label>
        <div>
          <button data-action="letter-dec">-</button>
          <button data-action="letter-inc">+</button>
        </div>
      </div>

      <div class="control">
        <label>Tamanho</label>
        <label id="fontSizeValue">1.0x</label>
        <div>
          <button data-action="font-dec">-</button>
          <button data-action="font-inc">+</button>
        </div>
      </div>
    </div>

    <div class="group">
      <h4>🎨 Aparência</h4>

      <div class="appearance-control">
        <label>Fonte</label>

        <select id="fontSelector">
          <option value="Arial">Normal</option>
          <option value="Verdana">Verdana</option>
        </select>
      </div>

      <div class="appearance-control">
        <label>Cor de fundo</label>

        <input type="color" id="backgroundColor" value="#d6c8bd" />
      </div>

      <div class="appearance-control">
        <label>Cor da fonte</label>

        <input type="color" id="fontColor" value="#2E2E2E" />
      </div>
    </div>

    <div class="group reading-group">
      <h4>🔊 Leitura</h4>

      <div class="reading-control">
        <label for="velocidade">Velocidade</label>

        <input type="range" min="0.5" max="2" step="0.1" value="1" id="velocidade" />
      </div>

      <div class="reading-control">
        <label for="vozes">Voz</label>

        <select id="vozes"></select>
      </div>

      <div class="reading-control">
        <label>Controles</label>

        <div class="buttons">
          <button id="playButton">▶️</button>
          <button id="pauseButton">⏸️ Pausar</button>
        </div>
      </div>
    </div>

    <div class="group">
      <button id="breakLinesButton">
        Quebrar linhas
      </button>
    </div>
  </aside>

  <!-- CONTEÚDO -->
  <div class="content" id="resultado">
    {{{textoHtml}}}
  </div>
</div>

<script>
  class ReaderUI {
    constructor() {
      this.content = document.getElementById("resultado");

      this.state = {
        lineSpacing: 1.6,
        wordSpacing: 0.2,
        letterSpacing: 0,
        fontSize: 1,
      };

      this.synth = window.speechSynthesis;
      this.utterance = null;

      this.init();
    }

    init() {
      this.bindEvents();
      this.loadVoices();
      this.applyStyles();

      speechSynthesis.onvoiceschanged = () => {
        this.loadVoices();
      };

      window.addEventListener("load", () => {
        this.loadVoices();

        setTimeout(() => {
          this.loadVoices();
        }, 500);
      });
    }

    bindEvents() {
      document.addEventListener("click", (event) => {
        const action = event.target.dataset.action;

        if (!action) return;

        switch (action) {
          case "line-inc":
            this.updateLineSpacing(0.2);
            break;

          case "line-dec":
            this.updateLineSpacing(-0.2);
            break;

          case "word-inc":
            this.updateWordSpacing(0.2);
            break;

          case "word-dec":
            this.updateWordSpacing(-0.2);
            break;

          case "letter-inc":
            this.updateLetterSpacing(0.1);
            break;

          case "letter-dec":
            this.updateLetterSpacing(-0.1);
            break;

          case "font-inc":
            this.updateFontSize(0.2);
            break;

          case "font-dec":
            this.updateFontSize(-0.2);
            break;
        }
      });

      document
        .getElementById("fontSelector")
        .addEventListener("change", (e) => {
          this.content.style.fontFamily = e.target.value;
        });

      document
        .getElementById("backgroundColor")
        .addEventListener("change", (e) => {
          this.content.style.setProperty(
            "--background-color",
            e.target.value
          );
        });

      document
        .getElementById("fontColor")
        .addEventListener("change", (e) => {
          this.content.style.setProperty(
            "--font-color",
            e.target.value
          );
        });

      document
        .getElementById("breakLinesButton")
        .addEventListener("click", () => {
          this.breakLines();
        });

      document
        .getElementById("playButton")
        .addEventListener("click", () => {
          this.readText();
        });

      document
        .getElementById("pauseButton")
        .addEventListener("click", () => {
          this.togglePause();
        });
    }

    applyStyles() {
      this.content.style.lineHeight =
        this.state.lineSpacing;

      this.content.style.wordSpacing =
        `${this.state.wordSpacing}em`;

      this.content.style.letterSpacing =
        `${this.state.letterSpacing}em`;

      this.content.style.fontSize =
        `${this.state.fontSize}em`;
    }

    updateLineSpacing(value) {
      const next =
        this.state.lineSpacing + value;

      if (next < 1) return;

      this.state.lineSpacing = next;

      this.content.style.lineHeight = next;

      document.getElementById(
        "lineValue"
      ).textContent = next.toFixed(1);
    }

    updateWordSpacing(value) {
      const next =
        this.state.wordSpacing + value;

      if (next < 0) return;

      this.state.wordSpacing = next;

      this.content.style.wordSpacing =
        `${next}em`;

      document.getElementById(
        "wordValue"
      ).textContent = next.toFixed(1);
    }

    updateLetterSpacing(value) {
      const next =
        this.state.letterSpacing + value;

      if (next < 0) return;

      this.state.letterSpacing = next;

      this.content.style.letterSpacing =
        `${next}em`;

      document.getElementById(
        "letterValue"
      ).textContent = next.toFixed(1);
    }

    updateFontSize(value) {
      const next =
        this.state.fontSize + value;

      if (next < 0.5) return;

      this.state.fontSize = next;

      this.content.style.fontSize =
        `${next}em`;

      document.getElementById(
        "fontSizeValue"
      ).textContent =
        `${next.toFixed(1)}x`;
    }

    breakLines() {
      const text = this.content.innerText;

      const formatted =
        text.replace(/\./g, ".<br><br>");

      this.content.innerHTML = formatted;
    }

    loadVoices() {
      const select =
        document.getElementById("vozes");

      const voices =
        this.synth.getVoices() || [];

      select.innerHTML = "";

      voices.forEach((voice, index) => {
        const option =
          document.createElement("option");

        option.value = index;

        option.textContent =
          `${voice.name} (${voice.lang})`;

        select.appendChild(option);
      });
    }

    readText() {
      const text =
        this.content.innerText.trim();

      if (!text) return;

      this.synth.cancel();

      this.utterance =
        new SpeechSynthesisUtterance(text);

      this.utterance.lang = "pt-BR";

      this.utterance.rate =
        document.getElementById(
          "velocidade"
        ).value;

      const voices =
        this.synth.getVoices() || [];

      const selectedVoice =
        document.getElementById("vozes").value;

      if (
        voices.length &&
        selectedVoice !== ""
      ) {
        this.utterance.voice =
          voices[selectedVoice];
      }

      this.utterance.onend = () => {
        this.resetPauseButton();
        this.utterance = null;
      };

      this.utterance.onerror = () => {
        this.utterance = null;
      };

      this.synth.speak(this.utterance);

      this.resetPauseButton();
    }

    togglePause() {
      const button =
        document.getElementById("pauseButton");

      if (
        this.synth.speaking &&
        !this.synth.paused
      ) {
        this.synth.pause();

        button.textContent =
          "▶️ Resumir";

        return;
      }

      if (this.synth.paused) {
        this.synth.resume();

        button.textContent =
          "⏸️ Pausar";
      }
    }

    resetPauseButton() {
      document.getElementById(
        "pauseButton"
      ).textContent = "⏸️ Pausar";
    }
  }

  new ReaderUI();
</script>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Arial, sans-serif;
  }

  /* LAYOUT */
  .main {
    display: flex;
    height: 100vh;
    overflow: hidden;
  }

  .sidebar {
    width: 260px;
    background: #2b2b2b;
    color: white;
    padding: 20px;

    overflow-y: auto;
    height: 100vh;

    flex-shrink: 0;
  }

  .content {
    flex: 1;

    overflow-y: auto;
    height: 100vh;

    padding: 20px;

    display: flex;
    justify-content: center;

    --background-color: #d6c8bd;
    --font-color: #2e2e2e;

    background-color: var(--background-color);
    color: var(--font-color);

    line-height: 1.6;
    word-spacing: 0.2em;
    letter-spacing: 0;
    font-size: 1em;
  }

  /* GRUPOS */
  .group {
    margin-bottom: 24px;
  }

  .group h4 {
    margin-bottom: 14px;
  }

  /* CONTROLES */
  .control {
    display: grid;

    grid-template-columns:
      1fr 60px auto;

    align-items: center;

    gap: 10px;

    margin-bottom: 12px;
  }

  .control label:nth-child(2) {
    text-align: center;
  }

  .control div {
    display: flex;
    gap: 6px;
  }

  /* BOTÕES */
  button {
    border: none;
    border-radius: 6px;

    background: #444;
    color: white;

    cursor: pointer;

    padding: 8px 12px;

    transition: background 0.2s;
  }

  button:hover {
    background: #666;
  }

  .control button {
    width: 32px;
    height: 32px;
    padding: 0;
  }

  /* APARÊNCIA */
  .appearance-control,
  .reading-control {
    display: flex;
    flex-direction: column;
    gap: 6px;

    margin-bottom: 14px;
  }

  .appearance-control label,
  .reading-control label {
    font-size: 14px;
    font-weight: bold;
  }

  select,
  input[type="color"] {
    width: 100%;
    height: 38px;
  }

  input[type="range"] {
    width: 100%;
  }

  .buttons {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }
</style>