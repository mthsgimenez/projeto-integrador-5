<h3>Digite ou cole seu texto:</h3>
<form method="POST" onsubmit="return validar()" action="/read">
    <textarea name="texto" id="texto" required></textarea>
    <p id="erro" style="color: red;"></p>
    <button type="submit" style="margin-top: 15px;">Abrir para leitura →</button>
</form>

<script>
    function validar() {
        const texto = document.getElementById("texto").value.trim();
        if (!texto) {
            document.getElementById("erro").textContent = "Por favor, insira um texto para leitura.";
            return false;
        }
        return true;
    }
</script>

<style>
    textarea {
        width: 100%;
        height: 150px;
        padding: 10px;
        font-size: 16px;
        border: 1px solid #ccc;
        border-radius: 10px;
        resize: none;
    }

    main {
        padding: 20px;
        max-width: 900px;
        margin: auto;
    }
</style>